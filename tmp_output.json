{
  "api_design": [
    {
      "module": "填报管理-模板",
      "apis": [
        {
          "method": "GET",
          "path": "/collect/template/list",
          "description": "分页查询模板列表，支持模板名称/分类ID/状态作为查询条件"
        },
        {
          "method": "GET",
          "path": "/collect/template/{id}",
          "description": "获取模板详情，包含Luckysheet JSON配置(luckysheetJson字段)"
        },
        {
          "method": "POST",
          "path": "/collect/template",
          "description": "新增模板，请求体中包含模板元数据及luckysheetJson"
        },
        {
          "method": "PUT",
          "path": "/collect/template",
          "description": "修改模板信息"
        },
        {
          "method": "DELETE",
          "path": "/collect/template/{id}",
          "description": "删除模板，支持批量删除(多个id逗号分隔)"
        },
        {
          "method": "POST",
          "path": "/collect/template/{id}/publish",
          "description": "发布/下架模板，请求体中传status字段(0=下架,1=发布)"
        }
      ]
    },
    {
      "module": "填报管理-数据",
      "apis": [
        {
          "method": "GET",
          "path": "/collect/data/list",
          "description": "分页查询填报数据列表，支持模板ID/分类/状态/填报人/时间范围筛选"
        },
        {
          "method": "GET",
          "path": "/collect/data/{id}",
          "description": "获取填报数据详情，含Luckysheet填充后的JSON"
        },
        {
          "method": "POST",
          "path": "/collect/data",
          "description": "新增或保存草稿填报数据"
        },
        {
          "method": "PUT",
          "path": "/collect/data",
          "description": "修改填报数据"
        },
        {
          "method": "POST",
          "path": "/collect/data/{id}/submit",
          "description": "提交数据，将状态从草稿(0)改为已提交(1)"
        },
        {
          "method": "DELETE",
          "path": "/collect/data/{id}",
          "description": "删除填报数据，支持批量"
        },
        {
          "method": "POST",
          "path": "/collect/data/{id}/approve",
          "description": "审批通过填报数据(关联流程时使用)"
        },
        {
          "method": "POST",
          "path": "/collect/data/{id}/reject",
          "description": "审批驳回填报数据"
        }
      ]
    },
    {
      "module": "报表管理",
      "apis": [
        {
          "method": "GET",
          "path": "/report/config/list",
          "description": "分页查询报表配置列表"
        },
        {
          "method": "GET",
          "path": "/report/config/{id}",
          "description": "获取报表配置详情(含JimuReport配置参数)"
        },
        {
          "method": "POST",
          "path": "/report/config",
          "description": "新增报表配置"
        },
        {
          "method": "PUT",
          "path": "/report/config",
          "description": "修改报表配置"
        },
        {
          "method": "DELETE",
          "path": "/report/config/{id}",
          "description": "删除报表配置"
        },
        {
          "method": "GET",
          "path": "/report/view/{id}",
          "description": "渲染报表，返回JimuReport的iframe URL或直接返回渲染内容"
        }
      ]
    },
    {
      "module": "分类管理",
      "apis": [
        {
          "method": "GET",
          "path": "/collect/category/list",
          "description": "获取分类树，返回树形结构数据"
        },
        {
          "method": "POST",
          "path": "/collect/category",
          "description": "新增分类节点"
        },
        {
          "method": "PUT",
          "path": "/collect/category",
          "description": "修改分类节点"
        },
        {
          "method": "DELETE",
          "path": "/collect/category/{id}",
          "description": "删除分类节点(含下级子节点)"
        }
      ]
    }
  ],
  "page_structure": "src/views/collect/ -- 数据填报模块\n  template/index.vue -- 模板列表页(分页表格+搜索+分类树筛选)\n  template/edit.vue -- 模板编辑页(内嵌Luckysheet编辑器)\n  data/index.vue -- 填报数据列表页(分页表格+状态筛选)\n  data/edit.vue -- 填报数据编辑页(内嵌Luckysheet编辑器)\n  data/detail.vue -- 填报数据查看页(只读模式展示Luckysheet)\n  category/index.vue -- 分类管理页(树形CRUD)\nsrc/views/report/ -- 报表模块\n  config/index.vue -- 报表配置列表页\n  config/edit.vue -- 报表配置编辑页\n  view/index.vue -- 报表查看页(iframe嵌入JimuReport)\n  dashboard/list.vue -- 大屏列表页\n  dashboard/index.vue -- 大屏查看页(iframe嵌入JimuBI)",
  "components": [
    {
      "name": "CollectSheet",
      "description": "封装的Luckysheet组件，支持编辑/只读两种模式，通过readonly prop控制",
      "props": [
        "luckysheetJson",
        "readonly",
        "height",
        "onSheetChange"
      ]
    },
    {
      "name": "ReportFrame",
      "description": "报表iframe加载组件，带loading动画和权限校验，统一处理跨域和token传递",
      "props": [
        "src",
        "height",
        "permission"
      ]
    },
    {
      "name": "ReportViewer",
      "description": "报表渲染组件，根据报表配置动态渲染JimuReport内容",
      "props": [
        "reportId",
        "params",
        "type"
      ]
    },
    {
      "name": "CategoryTree",
      "description": "分类树选择组件，支持单选/多选模式，可配合el-tree实现分类筛选",
      "props": [
        "categories",
        "value",
        "multiple",
        "onChange"
      ]
    }
  ],
  "store_design": "useCollectStore: 管理填报模块状态(templateList/dataList/categoryTree/currentTemplate/currentData)\n- actions: fetchTemplates, fetchDataList, fetchCategories, saveTemplate, saveData, submitData\nuseReportStore: 管理报表模块状态(configList/currentReport)\n- actions: fetchConfigs, fetchReport, saveConfig, deleteConfig\n遵循Pinia options API风格(state + getters + actions)",
  "permission_mapping": [
    {
      "permission_key": "collect:template:list",
      "description": "查询模板列表"
    },
    {
      "permission_key": "collect:template:add",
      "description": "新增模板"
    },
    {
      "permission_key": "collect:template:edit",
      "description": "修改模板"
    },
    {
      "permission_key": "collect:template:remove",
      "description": "删除模板"
    },
    {
      "permission_key": "collect:template:publish",
      "description": "发布/下架模板"
    },
    {
      "permission_key": "collect:data:list",
      "description": "查询填报数据"
    },
    {
      "permission_key": "collect:data:add",
      "description": "新增填报数据"
    },
    {
      "permission_key": "collect:data:edit",
      "description": "修改填报数据"
    },
    {
      "permission_key": "collect:data:remove",
      "description": "删除填报数据"
    },
    {
      "permission_key": "collect:data:submit",
      "description": "提交填报数据"
    },
    {
      "permission_key": "collect:data:approve",
      "description": "审批通过填报数据"
    },
    {
      "permission_key": "collect:data:reject",
      "description": "审批驳回填报数据"
    },
    {
      "permission_key": "collect:category:list",
      "description": "查询分类树"
    },
    {
      "permission_key": "collect:category:add",
      "description": "新增分类"
    },
    {
      "permission_key": "collect:category:edit",
      "description": "修改分类"
    },
    {
      "permission_key": "collect:category:remove",
      "description": "删除分类"
    },
    {
      "permission_key": "report:config:list",
      "description": "查询报表配置"
    },
    {
      "permission_key": "report:config:add",
      "description": "新增报表配置"
    },
    {
      "permission_key": "report:config:edit",
      "description": "修改报表配置"
    },
    {
      "permission_key": "report:config:remove",
      "description": "删除报表配置"
    },
    {
      "permission_key": "report:view",
      "description": "查看报表"
    }
  ],
  "notes": "遵循RuoYi-Vue3规范: API封装使用@/utils/request, 类型定义在src/types/api目录, store使用Pinia options API, 页面使用<script setup lang=ts name=Xxx>格式, 权限使用v-hasPermi指令。路由需在dynamicRoutes中注册, 类型需在src/types/api/index.ts中统一导出。"
}