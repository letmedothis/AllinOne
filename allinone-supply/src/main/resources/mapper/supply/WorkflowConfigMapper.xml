<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.allinone.supply.mapper.WorkflowConfigMapper"><resultMap id="Config" type="com.allinone.supply.domain.WorkflowConfig"><id property="id" column="id"/><result property="flowType" column="flow_type"/><result property="version" column="version"/><result property="supervisorCandidates" column="supervisor_candidates"/><result property="financeCandidates" column="finance_candidates"/></resultMap><select id="selectAll" resultMap="Config">select id,flow_type,version,supervisor_candidates,finance_candidates from workflow_configs order by flow_type,version desc</select><select id="selectLatest" resultMap="Config">select id,flow_type,version,supervisor_candidates,finance_candidates from workflow_configs where flow_type=#{flowType} order by version desc limit 1</select><insert id="insert">insert into workflow_configs(id,flow_type,version,supervisor_candidates,finance_candidates,updated_by,updated_at) values(#{id},#{flowType},#{version},#{supervisorCandidates},#{financeCandidates},#{updatedBy},now())</insert></mapper>
