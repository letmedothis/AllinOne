# Docker Compose 环境变量示例。
# 首次部署推荐直接执行 scripts/docker-deploy.sh（或 .bat），会自动生成含随机密钥的 .env。
# 手动部署：cp .env.example .env 后至少修改 MYSQL_ROOT_PASSWORD 与 JWT_SECRET。

# MySQL root 密码（后端数据源同时使用该值）
MYSQL_ROOT_PASSWORD=Change_Me_2026

# Redis 密码（为空表示无密码；redis 容器会自动按此值启用 --requirepass）
REDIS_PASSWORD=

# 后端 JWT 签名密钥，生产环境必须更换（建议 64 位以上随机字符串）
JWT_SECRET=please-generate-a-random-secret-key-at-least-32-chars

# 前端对外端口
HTTP_PORT=80

# 后端 JVM 参数（可选），如 -Xms512m -Xmx2g
JAVA_OPTS=
